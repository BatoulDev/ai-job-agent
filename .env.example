# Supabase project URL and publishable key (current Supabase API key
# convention). Both are safe to expose to the browser — they grant no
# access beyond what Row Level Security allows.
#
# For local development, start the local stack (`supabase start`) and read
# these three values from its output — or re-print them any time with
# `supabase status`. Never copy real values into this file; set them in
# .env.local (gitignored) instead. For a hosted project, get these from the
# Supabase dashboard's API settings.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses Row Level Security — never prefix with NEXT_PUBLIC_,
# never import the client built from this (src/lib/supabase/admin.ts) into
# a Client Component. Used only for trusted subscription/payment/analysis-
# task writes that have no client-facing insert/update RLS policy by design,
# and required to run `npm run test:db` (see LOCAL_TEST_DB_MARKER below).
# Also from `supabase status` locally.
SUPABASE_SECRET_KEY=

# Temporary. The /news page reads from a separate, dedicated online
# Supabase project while the rest of the app remains on local Supabase
# (see NEXT_PUBLIC_SUPABASE_URL above, which every other feature still
# uses). Server-only: never prefix with NEXT_PUBLIC_, since this is read
# only from a Server Component and must never reach the browser bundle.
#
# Use only that project's anon/public or publishable key — never its
# service_role or secret key. RLS on that project already restricts reads
# to published briefs and their public columns (source_url is excluded at
# the grant level), so the anon key grants no more than that regardless.
NEWS_SUPABASE_URL=
NEWS_SUPABASE_ANON_KEY=

# Local development only — used by scripts/seed-local-automation-users.mjs
# to create fictional test users (maya.haddad@test.local, karim.nassar@test.local,
# lina.mansour@test.local). Set this in .env.local to any local-only test
# password (at least 8 characters). The script refuses to run without it,
# and refuses to run against anything but a local (127.0.0.1/localhost)
# Supabase URL regardless. Never set a real password here or commit one —
# this file only ever documents the variable name.
# LOCAL_SEED_USER_PASSWORD=

# Local development only — required by tests/db/*.test.mjs (npm run
# test:db), scripts/run-db-tests.mjs, and
# scripts/db-test-crash-recovery-sweep.mjs. A second, independent guard on
# top of the 127.0.0.1/localhost hostname check — never hostname alone —
# so destructive test setup/cleanup only ever runs when this is
# deliberately set to the exact expected value in .env.local. Not a
# secret; the required value is a fixed literal
# (tests/db/localTestGuard.mjs: REQUIRED_LOCAL_TEST_MARKER), not something
# you choose yourself — copy the line below exactly.
#
# tests/db/localTestGuard.mjs fails closed (throws, refuses to run) unless
# ALL three independent checks pass: (1) NEXT_PUBLIC_SUPABASE_URL's host is
# 127.0.0.1/localhost/[::1], (2) this marker matches exactly, and (3) the
# connected database's public.plans catalog matches this project's expected
# rows. Any one of those failing means `npm run test:db` will not create or
# delete anything — it just errors out with a message naming what's wrong.
LOCAL_TEST_DB_MARKER=ai-job-agent-local-db-tests

# Whish Money / Whish Pay payment provider — server-only, all optional.
# Real Whish merchant approval, API documentation, and credentials are not
# yet available (see DATABASE_PLAN.md Part 6 for the full list of what is
# still needed). Leave unset in every environment until then: the checkout
# page detects missing configuration and shows an honest "payment is not
# available yet" message instead of a fake or broken checkout flow.
# WHISH_API_BASE_URL=
# WHISH_MERCHANT_ID=
# WHISH_API_SECRET=
