      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "parameters": {
        "method": "POST",
        "url": "={{ $json.appBaseUrl }}/api/internal/ingestion/list-sources",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ {} }}",
        "options": { "timeout": 30000 }
      },
      "credentials": { "httpBearerAuth": { "name": "Ingestion Worker Secret" } }
    },
    {
      "id": "d2f4f123-d797-4606-b204-654e81ad70af",
      "name": "Log List Sources Failure",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [448, 650],
      "notes": "Terminal failure for this run — nothing to loop over if source discovery itself failed. A human reviews the n8n execution log.",
      "parameters": {
        "mode": "manual",
        "assignments": { "assignments": [{ "id": "error", "name": "error", "value": "={{ $json.error?.message ?? 'list-sources call failed' }}", "type": "string" }] }
