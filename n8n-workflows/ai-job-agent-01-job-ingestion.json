              "outputKey": "workable",
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "conditions": [{ "leftValue": "={{ $('Split Out Sources').item.json.ats_type }}", "operator": { "type": "string", "operation": "equals" }, "rightValue": "workable" }],
