    },
    {
      "id": "d4fda19b-89d0-4ce7-99d4-6df854e6e147",
      "name": "Loop Sources (Rate Limited)",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [896, 464],
      "parameters": { "batchSize": 1 }
    },
    {
      "id": "77446e74-48d1-4334-bcb8-912b4f85f219",
      "name": "Fetch Source Jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1120, 464],
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 4,
      "waitBetweenTries": 5000,
      "parameters": {
        "method": "GET",
        "url": "={{ $json.feed_url }}",
        "authentication": "none",
